# Salin jadi .env lalu isi sesuai kebutuhan. Jangan commit file .env-nya.

# Tampilkan banner bawaan paket Baileys (default: dibungkam)
# BAILEYS_SHOW_BANNER=1

# Untuk command .uploadgh (upload file ke GitHub)
# GH_UPLOAD_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GH_UPLOAD_REPO=nama-repo-tujuan
# GH_UPLOAD_USER=username-github
# GH_UPLOAD_FOLDER=uploads
# GH_UPLOAD_BRANCH=main
